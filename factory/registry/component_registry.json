{
  "$schema": "factory/registry/schema/component_registry.schema.json",
  "registry_id": "application-factory-component-registry",
  "registry_schema_version": "1.0.0",
  "conventions": {
    "canonical_source": "factory/registry/component_registry.json",
    "identity": "component_id is the stable, unique, deterministic component identity; snake_case, never reused, never a floating selector",
    "versioning": "public component version is explicit SemVer MAJOR.MINOR.PATCH (ARCHITECTURE.md §11); floating selectors (latest/current/default/stable) are never accepted",
    "ownership": "owner records the accountable party; data_ownership.owner records the component that owns the data (ARCHITECTURE.md LAW-03). The registry owns no business data (ADR-0015 §4, §11)",
    "artifacts": "ARCHITECTURE.md §11 requires id + version + digest for a supplied artifact. No deployable artifact is published at Level 0, so every entry records artifact_type=none, digest=null, pinned=false (ARCHITECTURE.md §30; CONFORMANCE_REVIEW_1.2.0 DOD-02)",
    "lifecycle": "registry_state=registered records that the entry exists in the canonical registry. It certifies nothing: a registered component is not by that fact deployable or publishable (ARCHITECTURE.md §30)",
    "dependencies": "declared component-to-component dependencies carry an explicit version range; discovery never uses internal imports or internal database access (ARCHITECTURE.md §18)"
  },
