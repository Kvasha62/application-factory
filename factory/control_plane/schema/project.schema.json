{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory/control_plane/schema/project.schema.json",
  "title": "Control Plane Project",
  "description": "Mutable project container of the Application Factory Control Plane (Slice 1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "title", "status", "created_at", "pointers"],
  "properties": {
    "schema_version": { "const": "control-plane/project/v1" },
    "project_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "archived"] },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "pointers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "configuration"],
      "properties": {
        "requirements": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["requirements_id", "digest"],
              "properties": {
                "requirements_id": { "type": "string" },
                "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            }
          ]
        },
        "configuration": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["configuration_id", "digest"],
              "properties": {
                "configuration_id": { "type": "string" },
                "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            }
          ]
        }
      }
    }
  }
}
