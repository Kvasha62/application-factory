{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory/control_plane/schema/configuration_version_v2.schema.json",
  "title": "Control Plane ConfigurationVersion (v2)",
  "description": "Immutable, selector-free, exact-version technical configuration in the Composition-Request-shaped generation (S2-1). Identical to configuration/v1 except that the payload carries manifest.manifest_version and request-shaped golden_bundle/extensions, which the existing Composition Request requires. v1 documents stay valid and unchanged; a v1 version is never projected — a v2 successor (new version, new digest, new approval) is the only migration path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "configuration_id",
    "project_ref",
    "requirements_ref",
    "template_ref",
    "variant_ref",
    "manifest",
    "components",
    "configuration",
    "golden_bundle",
    "extensions",
    "branding",
    "attachments",
    "predecessor",
    "digest"
  ],
  "properties": {
    "schema_version": { "const": "control-plane/configuration/v2" },
    "configuration_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*/configurations/[1-9][0-9]*$" },
    "project_ref": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
    "requirements_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements_id", "digest"],
      "properties": {
        "requirements_id": { "type": "string" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "template_ref": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" }
      ],
      "description": "Reserved reference; the Product Template domain is not implemented."
    },
    "variant_ref": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" }
      ],
      "description": "Reserved reference; the Variant domain is not implemented."
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "manifest_version", "predecessor"],
      "properties": {
        "manifest_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*([_-][a-z0-9]+)*$" },
        "manifest_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "description": "Explicit SemVer MAJOR.MINOR.PATCH — the form the Composition Request requires."
        },
        "predecessor": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["manifest_id", "manifest_version", "manifest_digest"],
              "properties": {
                "manifest_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*([_-][a-z0-9]+)*$" },
                "manifest_version": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                },
                "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            }
          ],
          "description": "Manifest lineage of the composed platform; shape-checked only — publication state remains the Platform Manifest lifecycle's authority."
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "component_version"],
        "properties": {
          "component_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
          "component_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$",
            "description": "Exact selector-free version; range operators are forbidden."
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "description": "Project-scoped resolved configuration values; component facts stay in the canonical Component Registry."
    },
    "golden_bundle": {
      "oneOf": [
        { "type": "null" },
        { "type": "object" }
      ],
      "description": "Null (explicitly uncertified) or the Composition Request Golden Bundle reference object; its vocabulary is validated when the request is generated."
    },
    "extensions": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "items": { "type": "object" } }
      ],
      "description": "Null or the Composition Request extension list; its vocabulary is validated when the request is generated."
    },
    "branding": {
      "oneOf": [
        { "type": "null" },
        { "type": "object" }
      ]
    },
    "attachments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal", "approval", "build", "release"],
      "description": "Every value must be null: the proposal and the approval are separate immutable documents in Slice 2, never fields of the configuration payload.",
      "properties": {
        "proposal": { "type": "null" },
        "approval": { "type": "null" },
        "build": { "type": "null" },
        "release": { "type": "null" }
      }
    },
    "predecessor": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["configuration_id", "digest"],
          "properties": {
            "configuration_id": { "type": "string" },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      ],
      "description": "Append-only configuration chain: any technical change is a new version with a new digest."
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
